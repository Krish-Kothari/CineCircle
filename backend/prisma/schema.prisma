datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MediaType {
  MOVIE
  TV_SHOW
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

enum GroupRole {
  ADMIN
  MEMBER
}

// =========================================================================
// MODULE 1: KRISH (Auth, Taste Preferences, Watchlist & Episode Tracking)
// =========================================================================

model User {
  id                String                @id @default(uuid())
  name              String
  username          String                @unique
  email             String                @unique
  passwordHash      String
  subscribedOTTs    String[]
  totalWatchMinutes Int                   @default(0)
  createdAt         DateTime              @default(now())

  genrePreferences  UserGenrePreference[]
  watchlist         WatchlistEntry[]
  episodeLogs       EpisodeProgress[]
  reviews           UserReview[]
  recLogs           RecommendationLog[]
  groupMemberships  GroupMember[]
  addedGroupItems   GroupWatchlistItem[]
  pollVotes         GroupPollVote[]

  @@index([username, email])
}

model UserGenrePreference {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre       String
  weightScore Int      @default(5)

  @@unique([userId, genre])
  @@index([genre, weightScore])
}

model WatchlistEntry {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId         String
  media           MediaItem   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  status          WatchStatus @default(PLAN_TO_WATCH)
  watchedEpisodes Int         @default(0)
  personalNotes   String?
  updatedAt       DateTime    @updatedAt

  @@unique([userId, mediaId])
  @@index([userId, status])
}

model EpisodeProgress {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasonNumber  Int
  episodeNumber Int
  watchedAt     DateTime  @default(now())

  @@unique([userId, mediaId, seasonNumber, episodeNumber])
  @@index([userId, mediaId])
}







// =========================================================================
// MODULE 3: ARYAN (Friend Groups, Shared Watchlists & Group Watch Polls)
// =========================================================================

model FriendGroup {
  id          String               @id @default(uuid())
  name        String
  inviteCode  String               @unique
  description String?
  createdAt   DateTime             @default(now())

  members     GroupMember[]
  sharedList  GroupWatchlistItem[]
}

model GroupMember {
  id        String      @id @default(uuid())
  groupId   String
  group     FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole   @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupWatchlistItem {
  id          String          @id @default(uuid())
  groupId     String
  group       FriendGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  mediaId     String
  media       MediaItem       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedById   String
  addedBy     User            @relation(fields: [addedById], references: [id])
  pitchNote   String?
  status      String          @default("NOMINATED")
  voteCount   Int             @default(0)
  createdAt   DateTime        @default(now())

  votes       GroupPollVote[]

  @@unique([groupId, mediaId])
  @@index([groupId, status, voteCount])
}

model GroupPollVote {
  id          String             @id @default(uuid())
  groupItemId String
  groupItem   GroupWatchlistItem @relation(fields: [groupItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedAt     DateTime           @default(now())

  @@unique([groupItemId, userId])
}
// =========================================================================
// MODULE 2: HARSH (Catalog, Community Reviews & Hybrid Recommendations)
// =========================================================================

model MediaItem {
  id             String    @id @default(uuid())
  title          String
  type           MediaType
  synopsis       String?
  releaseYear    Int?
  runtimeMinutes Int?
  totalEpisodes  Int?
  genres         String[]
  posterUrl      String?
  avgRating      Float     @default(0)
  createdAt      DateTime  @default(now())

  streamingOptions StreamingOption[]
  reviews          UserReview[]
  recLogs          RecommendationLog[]
  watchlist        WatchlistEntry[]
  episodeLogs      EpisodeProgress[]
  groupItems       GroupWatchlistItem[]

  @@index([title])
  @@index([type, releaseYear])
}

model StreamingOption {
  id       String    @id @default(uuid())
  mediaId  String
  media    MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  platform String
  region   String    @default("IN")

  @@unique([mediaId, platform, region])
  @@index([platform])
}

model UserReview {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  createdAt DateTime  @default(now())

  @@unique([userId, mediaId])
  @@index([mediaId])
}

model RecommendationLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  score     Float
  reason    String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
